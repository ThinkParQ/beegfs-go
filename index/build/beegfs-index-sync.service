[Unit]
Description=BeeGFS Index Sync (Watch events to index suspect files)
Documentation=http://www.beegfs.com/content/documentation/
After=remote-fs.target beegfs-client.service
Wants=basic.target

[Service]
Type=simple
ExecStart=/opt/beegfs/sbin/beegfs-index-sync --cfg-file=/etc/beegfs/beegfs-index-sync.toml

# On stop the collector seals the segment it is writing and markwalk finishes the batch it is on.
# A batch stats every directory it touches on BeeGFS, so allow it time to complete.
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
